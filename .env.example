# Copy to .env (never committed). Loaded by the server and the CLI on start.
# --- who the sign-in emails come from ---
MU_MAIL_FROM="Webex Market Update <you@yourdomain.com>"

# --- pick ONE transport ---
# 1) Resend (simplest: one API key, free tier, no SMTP)  https://resend.com
# MU_RESEND_API_KEY=re_xxxxxxxxx
# 2) SendGrid
# MU_SENDGRID_API_KEY=SG.xxxxxxxxx
# 3) Any SMTP mailbox (Gmail: create an App Password at myaccount.google.com/apppasswords;
#    Outlook / Microsoft 365: smtp.office365.com; Webex-hosted or company mail: ask IT for host/port)
# MU_SMTP_HOST=smtp.gmail.com
# MU_SMTP_PORT=587
# MU_SMTP_USER=you@gmail.com
# MU_SMTP_PASS=xxxx xxxx xxxx xxxx

# --- other server settings ---
# MU_PUBLIC_URL=https://your-host.example.com     # base URL used inside the emailed links
# MU_SECRET=some-long-random-string               # signs session cookies (auto-generated if unset)
# MU_DEV_LINKS=0                                  # never show links on the page, even without mail
# TYPESAFE_API_KEY=...

# Model for the reads. Claude replaces TypeSafe as soon as ANTHROPIC_API_KEY is set (console.anthropic.com).
# ANTHROPIC_API_KEY=sk-ant-...
# MU_AI_PROVIDER=claude                       # or typesafe; unset = claude when a key is present
# MU_CLAUDE_MODEL=claude-haiku-4-5-20251001   # claude-sonnet-5 reads deeper and costs about twice as much
# MU_AI_MAX_CALLS_PER_DAY=4000                # spending guard per process; past it the rules answer until midnight UTC

# Or DeepSeek (cheapest; https://platform.deepseek.com) — picked automatically when this key is set:
# DEEPSEEK_API_KEY=sk-...
# MU_OPENAI_MODEL=deepseek-flash              # or deepseek-v4-pro
# Or any OpenAI-compatible host, e.g. DeepSeek/Qwen/Kimi on AWS Bedrock (data stays in the US region):
# MU_AI_PROVIDER=openai
# MU_OPENAI_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
# MU_OPENAI_API_KEY=...                       # a Bedrock API key
# MU_OPENAI_MODEL=...                         # the model id exactly as the host lists it
